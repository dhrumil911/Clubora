generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("FRONT_DESK") // OWNER, FRONT_DESK, BAR, MEMBER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MembershipTier {
  id                   String   @id @default(uuid())
  name                 String   @unique // Gold, Silver, Junior, Walk-in
  monthlyFee           Float
  courtDiscountPercent Float // e.g. 100 for Gold, 50 for Silver
  shopDiscountPercent  Float // e.g. 20 for Gold, 10 for Silver
  barDiscountPercent   Float // e.g. 20 for Gold, 10 for Silver
  description          String
  members              Member[]
}

model Member {
  id         String         @id @default(uuid())
  memberCode String         @unique
  name       String
  email      String         @unique
  phone      String
  tierId     String
  tier       MembershipTier @relation(fields: [tierId], references: [id])
  joinedAt   DateTime       @default(now())
  expiresAt  DateTime
  status     String         @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  bookings   Booking[]
  barTabs    BarTab[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Court {
  id          String    @id @default(uuid())
  name        String    @unique // Tennis 1, Tennis 2, Cricket 1, Padel 1
  sport       String // TENNIS, CRICKET, PADEL, BADMINTON
  hourlyRate  Float
  isAvailable Boolean   @default(true)
  bookings    Booking[]
}

model Booking {
  id            String   @id @default(uuid())
  courtId       String
  court         Court    @relation(fields: [courtId], references: [id])
  memberId      String?
  member        Member?  @relation(fields: [memberId], references: [id])
  customerName  String // Member name or Walk-in name
  bookingDate   String // YYYY-MM-DD
  startTime     String // e.g. "18:00"
  endTime       String // e.g. "19:00"
  isSocialPlay  Boolean  @default(false)
  playersCount  Int      @default(1)
  originalFee   Float
  discountFee   Float
  finalFee      Float
  paymentStatus String   @default("PAID") // PAID, PENDING
  status        String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  createdAt     DateTime @default(now())
}

model Product {
  id                String                 @id @default(uuid())
  name              String
  category          String // RACKET, BALLS, SHOES, ACCESSORIES, APPAREL
  price             Float
  stockQuantity     Int
  lowStockThreshold Int                    @default(5)
  description       String?
  transactions      InventoryTransaction[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model InventoryTransaction {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  type       String // SALE_POS, SALE_ONLINE, RESTOCK
  quantity   Int
  unitPrice  Float
  totalPrice Float
  channel    String // COUNTER, ONLINE
  date       DateTime @default(now())
}

model BarItem {
  id          String         @id @default(uuid())
  name        String
  category    String // BEVERAGE, SNACK, MEAL
  price       Float
  isAvailable Boolean        @default(true)
  orderItems  BarOrderItem[]
}

model BarTab {
  id              String         @id @default(uuid())
  tabNumber       String         @unique
  memberId        String?
  member          Member?        @relation(fields: [memberId], references: [id])
  customerName    String
  tableNumber     String?
  status          String         @default("OPEN") // OPEN, SETTLED, CANCELLED
  totalAmount     Float          @default(0)
  discountPercent Float          @default(0)
  discountAmount  Float          @default(0)
  finalAmount     Float          @default(0)
  paymentMethod   String? // CASH, CARD, UPI
  items           BarOrderItem[]
  openedAt        DateTime       @default(now())
  settledAt       DateTime?
}

model BarOrderItem {
  id         String  @id @default(uuid())
  tabId      String
  tab        BarTab  @relation(fields: [tabId], references: [id], onDelete: Cascade)
  barItemId  String
  barItem    BarItem @relation(fields: [barItemId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String
  interest  String // Membership, Court Trial, Shop, Events
  status    String   @default("NEW") // NEW, CONTACTED, QUOTED, CONVERTED, LOST
  notes     String?
  quotes    Quote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  tierName   String
  courtHours Int      @default(0)
  totalPrice Float
  validUntil String
  status     String   @default("SENT") // SENT, ACCEPTED, DECLINED
  createdAt  DateTime @default(now())
}

model Shift {
  id        String @id @default(uuid())
  staffName String
  role      String // Front Desk, Bar/Kitchen, Court Supervisor
  date      String // YYYY-MM-DD
  startTime String // "08:00"
  endTime   String // "16:00"
  status    String @default("SCHEDULED") // SCHEDULED, COMPLETED, ABSENT
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  clientName    String
  clientEmail   String
  type          String // CORPORATE, MEMBERSHIP
  amount        Float
  dueDate       String // YYYY-MM-DD
  status        String   @default("PENDING") // PENDING, PAID, OVERDUE
  createdAt     DateTime @default(now())
}
